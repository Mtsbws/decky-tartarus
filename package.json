{
  "name": "decky-tartarus",
  "version": "1.0.0",
  "description": "Razer Synapse for the Steam Deck: remap a Razer Tartarus Pro with actuation, Hypershift, per-game profiles and lighting",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "PYTHONPATH=py_modules python3 -m unittest"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "razer",
    "tartarus"
  ],
  "author": "Matisse Bauwens",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mtsbws/decky-tartarus"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
